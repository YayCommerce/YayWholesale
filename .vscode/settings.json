  // Include WooCommerce source code for better IntelliSense
  "intelephense.environment.includePaths": [
    "F:/LT/php/wordpress/wp-content/plugins/woocommerce"
  ],

  // Optional: Index your theme and mu-plugins
  "intelephense.environment.includePaths": [
    "F:/LT/php/wordpress/wp-content/themes",
    "F:/LT/php/wordpress/wp-content/mu-plugins",
    "F:/LT/php/wordpress/wp-content/plugins/woocommerce"
  ],

  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
  },
  "editor.suggest.snippetsPreventQuickSuggestions": false

